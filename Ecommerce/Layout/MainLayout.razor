@using Ecommerce.Layout.Menu
@inherits LayoutComponentBase

<AuthorizeView>
    <NotAuthorized>
        @Body
    </NotAuthorized>
    <Authorized>
        <SidebarMenu></SidebarMenu>
        <main class="w-full md:w-[calc(100%-256px)] md:ml-64 bg-gray-200 min-h-screen transition-all main">
            <NavbarMenu></NavbarMenu>
            <div class="p-6">
                @Body
            </div>
        </main>
    </Authorized>
</AuthorizeView>