@page "/admin/user"
@using SharedLibrary.Dtos.Users
@attribute [Authorize(Policy = Permissions.Users.View)]
@inject Microsoft.Extensions.Localization.IStringLocalizer<User> _localizer

<PageTitle>@_localizer["Title"]</PageTitle>
<HeadingTitleComponent Title="@_localizer["Title"]" Description="@_localizer["Desc"]" />

<MudTable T="@UserDto"
          @ref="_table"
          ServerData="ServerReload"
          SortLabel="@_localizer["Sort"]"
          RowClass="cursor-pointer"
          Elevation="25"
          Height="600px"
          Hover="true"
          Dense="@TableSetting.Dense"
          Bordered="@TableSetting.Bordered"
          Striped="@TableSetting.Striped"
          FixedHeader="true"
          Virtualize="true">
    <ToolBarContent>
        <div class="mud-text-align-center justify-center">
            @if (_canCreate)
            {
                <MudButton Elevation="4"
                           Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.AddCircleOutline"
                           OnClick="(() => InvokeModal())"
                           Class="transition-all duration-300 ease-in-out transform hover:-translate-y-1 hover:scale-105 shadow-md hover:shadow-xl rounded-xl px-4 py-2 text-white">
                    @_localizer["Create"]
                </MudButton>
            }
        </div>
        <MudSpacer />
        @if (_canSearch)
        {
            <MudTextField T="@string"
                          Placeholder="@_localizer["Search"]"
                          ValueChanged="@(s => OnSearch(s))"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          IconSize="Size.Medium"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Class="rounded-xl shadow-sm focus:shadow-md transition-all duration-200 w-full max-w-sm" />
        }
    </ToolBarContent>
    <HeaderContent>
        <MudTh>
            <MudTableSortLabel SortLabel="FirstName" T="@UserDto">@_localizer["First Name"]</MudTableSortLabel>
        </MudTh>
        <MudTh>
            <MudTableSortLabel SortLabel="LastName" T="@UserDto">@_localizer["Last Name"]</MudTableSortLabel>
        </MudTh>
        <MudTh>
            <MudTableSortLabel SortLabel="UserName" T="@UserDto">@_localizer["UserName"]</MudTableSortLabel>
        </MudTh>
        <MudTh>
            <MudTableSortLabel SortLabel="Email" T="@UserDto">@_localizer["Email"]</MudTableSortLabel>
        </MudTh>
        <MudTh>
            <MudTableSortLabel SortLabel="PhoneNumber" T="@UserDto">@_localizer["PhoneNumber"]</MudTableSortLabel>
        </MudTh>
        <MudTh Style="text-align:right">@_localizer["Actions"]</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="@_localizer["First Name"]">
            <MudHighlighter Text="@context.FirstName" />
        </MudTd>
        <MudTd DataLabel="@_localizer["Last Name"]">
            <MudHighlighter Text="@context.LastName" />
        </MudTd>
        <MudTd DataLabel="@_localizer["Username"]">
            <MudHighlighter Text="@context.UserName" />
        </MudTd>
        <MudTd DataLabel="@_localizer["Email"]">
            <MudHighlighter Text="@context.Email" />
        </MudTd>
        <MudTd DataLabel="@_localizer["PhoneNumber"]">
            <MudHighlighter Text="@context.PhoneNumber" />
        </MudTd>
        <MudTd DataLabel="@_localizer["Actions"]">
            <MudStack Row=true Spacing="2" AlignItems="AlignItems.End" Justify="Justify.FlexEnd">
                @* @if (_canEdit)
                {
                    <MudTooltip Text="@_localizer["Edit"]" Style="@($"background:{Colors.Yellow.Darken4}")">
                        <MudIconButton Icon="@Icons.Material.Outlined.Edit"
                                       Color="Color.Default"
                                       Style="@($"color:{Colors.Yellow.Darken4}")"
                                       OnClick="(() => InvokeModal(context.Id))"
                                       Class="hover:scale-125 transition-transform duration-200 rounded-full bg-white shadow-md ring-1 ring-gray-200" />
                    </MudTooltip>
                } *@
                @if (_canViewRoles)
                {
                    <MudTooltip Text="@_localizer["Manage Roles"]" Style="@($"background:{Colors.Orange.Darken4}")">
                        <MudIconButton Icon="@Icons.Material.Outlined.Rule"
                                       Color="Color.Default"
                                       Style="@($"color:{Colors.Orange.Darken4}")"
                                       OnClick="(() => ManageRoles(context.Id, context.Email))"
                                       Class="hover:scale-125 transition-transform duration-200 rounded-full bg-white shadow-md ring-1 ring-gray-200" />
                    </MudTooltip>
                }
            </MudStack>

        </MudTd>
    </RowTemplate>
    <PagerContent>
        <TablePagerComponent />
    </PagerContent>
</MudTable>