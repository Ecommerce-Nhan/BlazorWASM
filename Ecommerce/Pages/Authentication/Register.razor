@page "/admin/register"
@layout AuthLayout
@attribute [AllowAnonymous]

<div class="relative w-full rounded-3xl bg-gray-100 px-6 py-4 shadow-md">
    <label for="" class="mt-3 block text-center text-sm font-semibold text-gray-700">
        Register
    </label>
    <form method="#" action="#" class="mt-10">

        <div>
            <input type="text" placeholder="Full Name" class="mt-1 block h-11 w-full rounded-xl border-none bg-gray-100 shadow-lg hover:bg-blue-100 focus:bg-blue-100 focus:ring-0">
        </div>

        <div class="mt-7">
            <input type="email" placeholder="Email" class="mt-1 block h-11 w-full rounded-xl border-none bg-gray-100 shadow-lg hover:bg-blue-100 focus:bg-blue-100 focus:ring-0">
        </div>

        <div class="mt-7">
            <input type="password" placeholder="Password" class="mt-1 block h-11 w-full rounded-xl border-none bg-gray-100 shadow-lg hover:bg-blue-100 focus:bg-blue-100 focus:ring-0">
        </div>

        <div class="mt-7">
            <input type="password" placeholder="Confirm Password" class="mt-1 block h-11 w-full rounded-xl border-none bg-gray-100 shadow-lg hover:bg-blue-100 focus:bg-blue-100 focus:ring-0">
        </div>

        <div class="mt-7">
            <button class="w-full transform rounded-xl bg-green-500 py-3 text-white shadow-xl transition duration-500 ease-in-out hover:shadow-inner hover:-translate-x hover:scale-105 focus:outline-none">
                Create Account
            </button>
        </div>

        <div class="mt-7 flex items-center text-center">
            <hr class="border-1 w-full rounded-md border-gray-300">
            <label class="block w-full text-sm font-medium text-gray-600">
                Or sign up with
            </label>
            <hr class="border-1 w-full rounded-md border-gray-300">
        </div>

        <div class="mt-7 flex w-full justify-center">
            <button class="mr-5 transform cursor-pointer rounded-xl border-none bg-blue-500 px-4 py-2 text-white shadow-xl transition duration-500 ease-in-out hover:shadow-inner hover:-translate-x hover:scale-105">
                Facebook
            </button>

            <button class="transform cursor-pointer rounded-xl border-none bg-red-500 px-4 py-2 text-white shadow-xl transition duration-500 ease-in-out hover:shadow-inner hover:-translate-x hover:scale-105">
                Google
            </button>
        </div>

        <div class="mt-7">
            <div class="flex items-center justify-center">
                <label class="mr-2">Already have an account?</label>
                <a href="admin/login" class="transform text-blue-500 transition duration-500 ease-in-out hover:-translate-x hover:scale-105">
                    Login here
                </a>
            </div>
        </div>
    </form>
</div>
